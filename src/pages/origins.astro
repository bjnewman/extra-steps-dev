---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allTerms = await getCollection('terms', ({ data }) => !data.draft && data.category === 'historical');
const sortedTerms = allTerms.sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
---

<Base title="Origins" description="Buzzwords that graduated — the tech industry's greatest 'X is just Y' moments">
  <div class="origins-wrap">

    <nav class="origins-nav" aria-label="Breadcrumb">
      <a href="/" class="origins-nav__back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All terms
      </a>
    </nav>

    <header class="origins-hero">
      <h1 class="origins-hero__title">Origins</h1>
      <p class="origins-hero__subtitle">Buzzwords that graduated</p>
    </header>

    <div class="origins-intro">
      <p>
        Every hype cycle produces buzzwords that get repeated until they lose all meaning.
        Product directors hear "MCP" on a podcast and want you to use it to "orchestrate all our APIs into one."
        Marketing teams rebrand solved problems as breakthroughs. The confusion is real, and this site exists to cut through it.
      </p>
      <p>
        But we keep these historical entries around as a reminder to stay humble.
        Every generation of tech has had its "X is just Y" moment — and sometimes the people
        who were right about the primitives turned out to be completely wrong about what mattered.
        AI is a genuinely transformational technology. This site was built with it.
      </p>
    </div>

    <!-- The BrandonM moment -->
    <section class="origins-callout">
      <div class="origins-callout__header">
        <span class="origins-callout__label">The founding moment</span>
        <span class="origins-callout__date">April 2007</span>
      </div>
      <blockquote class="origins-callout__quote">
        <p>"For a Linux user, you can already build such a system yourself quite trivially by getting an FTP account, mounting it locally with curlftpfs, and then using SVN or CVS..."</p>
      </blockquote>
      <p class="origins-callout__attr">
        — <a href="https://news.ycombinator.com/item?id=9224" target="_blank" rel="noopener noreferrer">BrandonM on Hacker News</a>, commenting on Dropbox's Y Combinator demo (<a href="https://news.ycombinator.com/item?id=8863" target="_blank" rel="noopener noreferrer">item 8863</a>)
      </p>
      <p class="origins-callout__note">
        BrandonM was right about the primitives. Dropbox was worth $12 billion at IPO.
        Drew Houston resurfaced this comment eleven years later.
        Knowing what something is made of doesn't tell you whether it matters.
      </p>
    </section>

    <!-- Historical entries -->
    <section class="origins-entries">
      <h2 class="origins-entries__heading">The graduated buzzwords</h2>
      <ul class="origins-entries__list">
        {sortedTerms.map((term) => {
          const akaList = term.data.aka
            ? (Array.isArray(term.data.aka) ? term.data.aka : [term.data.aka])
            : [];
          return (
            <li class="origins-entry">
              <a href={`/terms/${term.id}/`} class="origins-entry__link">
                <div class="origins-entry__header">
                  <span class="origins-entry__term">{term.data.title}</span>
                  {akaList.length > 0 && (
                    <span class="origins-entry__aka">{akaList.join(' · ')}</span>
                  )}
                </div>
                <div class="origins-entry__eq">
                  <span class="origins-entry__arrow" aria-hidden="true">=</span>
                  <span class="origins-entry__primitives">
                    {term.data.primitives.join(' + ')}
                  </span>
                </div>
                <p class="origins-entry__tagline">{term.data.tagline}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="origins-coda">
      <p>
        Some of today's AI buzzwords will graduate too. Others will quietly disappear once the hype fades.
        Understanding the primitives won't tell you which is which — but it will help you
        have better conversations about it while we all figure it out together.
      </p>
    </section>

  </div>
</Base>

<style>
  .origins-wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-8) var(--space-16);
  }

  /* ── Nav ────────────────────────────────────────────────────────── */
  .origins-nav {
    margin-block-end: var(--space-6);
  }

  .origins-nav__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .origins-nav__back:hover {
    color: var(--color-accent);
  }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .origins-hero {
    margin-block-end: var(--space-6);
  }

  .origins-hero__title {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1.1;
  }

  .origins-hero__subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-start: var(--space-2);
  }

  /* ── Intro ─────────────────────────────────────────────────────── */
  .origins-intro {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
  }

  .origins-intro p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-4);
  }

  .origins-intro p:last-child {
    margin-block-end: 0;
  }

  .origins-intro strong {
    color: var(--color-text);
  }

  /* ── BrandonM callout ──────────────────────────────────────────── */
  .origins-callout {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
  }

  .origins-callout__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }

  .origins-callout__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
  }

  .origins-callout__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .origins-callout__quote {
    border-inline-start: 3px solid var(--color-marketing);
    background: var(--color-marketing-bg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    padding: var(--space-4);
    margin-block-end: var(--space-3);
  }

  .origins-callout__quote p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    font-style: italic;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .origins-callout__attr {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-block-end: var(--space-4);
  }

  .origins-callout__attr a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .origins-callout__attr a:hover {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  .origins-callout__note {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .origins-callout__note strong {
    color: var(--color-text);
  }

  /* ── Entry list ────────────────────────────────────────────────── */
  .origins-entries {
    margin-block-end: var(--space-8);
  }

  .origins-entries__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
  }

  .origins-entries__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .origins-entry {
    border-block-end: 1px solid var(--color-border);
  }

  .origins-entry:last-child {
    border-block-end: none;
  }

  .origins-entry__link {
    display: block;
    padding: var(--space-4);
    text-decoration: none;
    transition: background var(--duration-fast) var(--easing-standard);
  }

  .origins-entry__link:hover {
    background: var(--color-row-hover);
  }

  .origins-entry__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-1);
  }

  .origins-entry__term {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-marketing);
  }

  .origins-entry__link:hover .origins-entry__term {
    color: var(--color-accent);
  }

  .origins-entry__aka {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .origins-entry__eq {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
  }

  .origins-entry__arrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-arrow);
  }

  .origins-entry__primitives {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primitive);
  }

  .origins-entry__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-style: italic;
  }

  /* ── Coda ───────────────────────────────────────────────────────── */
  .origins-coda {
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-border);
  }

  .origins-coda p {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    font-style: italic;
  }
</style>
