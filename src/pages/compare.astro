---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allTerms = await getCollection('terms', ({ data }) => !data.draft);
const sortedTerms = allTerms.sort((a, b) => a.data.title.localeCompare(b.data.title));

const termsData = sortedTerms.map((t) => ({
  id: t.id,
  title: t.data.title,
  aka: t.data.aka,
  tagline: t.data.tagline,
  primitives: t.data.primitives,
  category: t.data.category,
}));
---

<Base title="Compare terms" description="See how two AI marketing terms map to the same underlying primitives">
  <div class="compare-wrap">

    <nav class="compare-nav" aria-label="Breadcrumb">
      <a href="/" class="compare-nav__back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All terms
      </a>
    </nav>

    <h1 class="compare-heading">Compare terms</h1>
    <p class="compare-subhead">See where the marketing diverges and the primitives converge.</p>

    <!-- Term selectors -->
    <div class="compare-form" id="compare-form">
      <div class="compare-form__field">
        <label for="term-a" class="compare-form__label">Term A</label>
        <select id="term-a" class="compare-form__select">
          <option value="">Select a term…</option>
          {sortedTerms.map((t) => (
            <option value={t.id}>{t.data.title}</option>
          ))}
        </select>
      </div>

      <span class="compare-form__vs" aria-hidden="true">vs</span>

      <div class="compare-form__field">
        <label for="term-b" class="compare-form__label">Term B</label>
        <select id="term-b" class="compare-form__select">
          <option value="">Select a term…</option>
          {sortedTerms.map((t) => (
            <option value={t.id}>{t.data.title}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Comparison result (populated by JS) -->
    <div id="compare-result" class="compare-result" hidden></div>

    <!-- Empty / initial state -->
    <div id="compare-empty" class="compare-empty">
      <p>Select two terms above to compare their underlying primitives.</p>
    </div>

  </div>
</Base>

<!-- Embed term data and run comparison logic (is:inline so Astro interpolates the JSON) -->
<script is:inline define:vars={{ termsDataJson: JSON.stringify(termsData) }}>
  const termsData = JSON.parse(termsDataJson);
  const termsMap = new Map(termsData.map(t => [t.id, t]));

  const selectA = document.getElementById('term-a');
  const selectB = document.getElementById('term-b');
  const result = document.getElementById('compare-result');
  const empty = document.getElementById('compare-empty');

  function esc(s) {
    const el = document.createElement('span');
    el.textContent = s;
    return el.innerHTML;
  }

  function renderComparison(a, b) {
    const shared = a.primitives.filter(p => b.primitives.includes(p));
    const onlyA = a.primitives.filter(p => !b.primitives.includes(p));
    const onlyB = b.primitives.filter(p => !a.primitives.includes(p));

    result.innerHTML = `
      <div class="compare-columns">
        <div class="compare-col">
          <h2 class="compare-col__title">${esc(a.title)}</h2>
          <p class="compare-col__tagline">${esc(a.tagline)}</p>
          <span class="compare-col__badge">${esc(a.category)}</span>
          <a href="/terms/${a.id}/" class="compare-col__link">Full details →</a>
        </div>
        <div class="compare-col">
          <h2 class="compare-col__title">${esc(b.title)}</h2>
          <p class="compare-col__tagline">${esc(b.tagline)}</p>
          <span class="compare-col__badge">${esc(b.category)}</span>
          <a href="/terms/${b.id}/" class="compare-col__link">Full details →</a>
        </div>
      </div>

      <div class="compare-section">
        <h3 class="compare-section__heading">Shared primitives</h3>
        ${shared.length > 0
          ? `<ul class="compare-primitives">${shared.map(p =>
              `<li class="compare-primitives__item compare-primitives__item--shared">${esc(p)}</li>`
            ).join('')}</ul>
            <p class="compare-section__note">Different marketing labels for overlapping implementations.</p>`
          : `<p class="compare-section__none">No overlapping primitives — these terms solve genuinely different problems.</p>`
        }
      </div>

      <div class="compare-diff">
        <div class="compare-diff__col">
          <h3 class="compare-diff__heading">Only in ${esc(a.title)}</h3>
          ${onlyA.length > 0
            ? `<ul class="compare-primitives">${onlyA.map(p =>
                `<li class="compare-primitives__item">${esc(p)}</li>`
              ).join('')}</ul>`
            : `<p class="compare-diff__none">—</p>`
          }
        </div>
        <div class="compare-diff__col">
          <h3 class="compare-diff__heading">Only in ${esc(b.title)}</h3>
          ${onlyB.length > 0
            ? `<ul class="compare-primitives">${onlyB.map(p =>
                `<li class="compare-primitives__item">${esc(p)}</li>`
              ).join('')}</ul>`
            : `<p class="compare-diff__none">—</p>`
          }
        </div>
      </div>
    `;

    result.hidden = false;
    empty.hidden = true;
  }

  function update() {
    const a = termsMap.get(selectA.value);
    const b = termsMap.get(selectB.value);

    if (a && b && a.id !== b.id) {
      renderComparison(a, b);
      const url = new URL(window.location.href);
      url.searchParams.set('a', a.id);
      url.searchParams.set('b', b.id);
      history.replaceState(null, '', url.toString());
    } else {
      result.hidden = true;
      empty.hidden = false;
    }
  }

  // Initialize from query params
  const params = new URLSearchParams(window.location.search);
  const initA = params.get('a');
  const initB = params.get('b');
  if (initA) selectA.value = initA;
  if (initB) selectB.value = initB;
  if (initA && initB) update();

  selectA.addEventListener('change', update);
  selectB.addEventListener('change', update);
</script>

<style>
  .compare-wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-8) var(--space-16);
  }

  .compare-nav {
    margin-block-end: var(--space-6);
  }

  .compare-nav__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .compare-nav__back:hover {
    color: var(--color-accent);
  }

  .compare-heading {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-block-end: var(--space-2);
  }

  .compare-subhead {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-block-end: var(--space-6);
  }

  /* ── Selectors ─────────────────────────────────────────────────── */
  .compare-form {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    margin-block-end: var(--space-8);
    flex-wrap: wrap;
  }

  .compare-form__field {
    flex: 1;
    min-width: 10rem;
  }

  .compare-form__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-1);
  }

  .compare-form__select {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .compare-form__select:focus {
    border-color: var(--color-accent);
    outline: 2px solid oklch(58% 0.22 280 / 0.15);
    outline-offset: 1px;
  }

  .compare-form__vs {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    padding-block-end: var(--space-2);
    flex-shrink: 0;
  }

  /* ── Result ────────────────────────────────────────────────────── */
  .compare-empty {
    text-align: center;
    padding: var(--space-12) var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Columns — side by side term cards */
  :global(.compare-columns) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-block-end: var(--space-6);
  }

  :global(.compare-col) {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
  }

  :global(.compare-col__title) {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-marketing);
    margin-block-end: var(--space-2);
  }

  :global(.compare-col__tagline) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin-block-end: var(--space-3);
  }

  :global(.compare-col__badge) {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-badge-text);
    background: var(--color-badge-bg);
    padding: 2px var(--space-2);
    border-radius: var(--border-radius-sm);
    text-transform: lowercase;
    letter-spacing: 0.02em;
    margin-inline-end: var(--space-2);
  }

  :global(.compare-col__link) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
  }

  :global(.compare-col__link:hover) {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* Section headings */
  :global(.compare-section) {
    margin-block-end: var(--space-6);
  }

  :global(.compare-section__heading),
  :global(.compare-diff__heading) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
  }

  :global(.compare-section__note) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin-block-start: var(--space-3);
  }

  :global(.compare-section__none) {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-style: italic;
  }

  /* Primitive pills */
  :global(.compare-primitives) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  :global(.compare-primitives__item) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primitive);
    background: var(--color-surface-raised);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--border-radius);
    border: 1px solid var(--color-border);
  }

  :global(.compare-primitives__item--shared) {
    border-color: var(--color-primitive);
    background: var(--color-accent-bg);
  }

  /* Diff columns */
  :global(.compare-diff) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  :global(.compare-diff__none) {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  @media (max-width: 600px) {
    :global(.compare-columns),
    :global(.compare-diff) {
      grid-template-columns: 1fr;
    }
  }
</style>
