---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TermRow from '../components/TermRow.astro';

const allTerms = await getCollection('terms', ({ data }) => !data.draft);
const sortedTerms = allTerms.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const categoryCounts = sortedTerms.reduce((acc, t) => {
  acc[t.data.category] = (acc[t.data.category] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const categories = ['patterns', 'historical', 'data', 'protocols', 'architecture'] as const;
---

<Base title="extra-steps.dev" showSearch={true}>
  <!-- Search bar in header slot -->
  <div slot="search" class="header-search">
    <label for="search-input" class="visually-hidden">Search terms</label>
    <div class="header-search__wrapper">
      <svg class="header-search__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search terms, primitives…"
        autocomplete="off"
        spellcheck="false"
        class="header-search__input"
      />
      <kbd class="header-search__kbd" aria-hidden="true">/</kbd>
    </div>
  </div>

  <!-- Table header -->
  <div class="table-header">
    <div class="table-header__inner">
      <div class="table-cols">
        <div class="table-cols__item table-cols__item--filter">
          <label for="filter-category" class="visually-hidden">Filter by category</label>
          <select id="filter-category" class="table-filter-select">
            <option value="">all categories</option>
            {categories.map((cat) => (
              <option value={cat}>{cat} ({categoryCounts[cat] ?? 0})</option>
            ))}
          </select>
        </div>
        <button class="table-cols__item table-cols__item--sortable" type="button" data-sort="title">
          term
          <svg class="sort-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M5 2L8 6H2L5 2Z" fill="currentColor"/>
          </svg>
        </button>
        <span class="table-cols__item table-cols__item--span">primitives</span>
      </div>
      <div class="table-count">
        <span id="result-count">{sortedTerms.length}</span> terms
        <span class="table-count__sep" aria-hidden="true">·</span>
        <a href="/origins" class="table-count__link">Origins</a>
        <span class="table-count__sep" aria-hidden="true">·</span>
        <a href="/compare" class="table-count__link">Compare</a>
      </div>
    </div>
  </div>

  <!-- Terms list -->
  <ul class="terms-list" id="terms-list" aria-label="All terms">
    {sortedTerms.map((term) => (
      <li class="terms-list__item" data-term={`${term.data.title} ${Array.isArray(term.data.aka) ? term.data.aka.join(' ') : (term.data.aka ?? '')} ${term.data.primitives.join(' ')} ${term.data.tagline} ${term.data.category}`.toLowerCase()} data-category={term.data.category} data-title={term.data.title.toLowerCase()} data-published={term.data.publishedAt.toISOString()}>
        <TermRow
          id={term.id}
          title={term.data.title}
          aka={term.data.aka}
          tagline={term.data.tagline}
          primitives={term.data.primitives}
          category={term.data.category}
          snippet={term.data.snippet}
        />
      </li>
    ))}
  </ul>

  <!-- Suggest a term CTA -->
  <div class="suggest-cta" id="suggest-cta">
    <div class="suggest-cta__inner">
      <p class="suggest-cta__text">Know a buzzword that's just something else with extra steps?</p>
      <a href="https://github.com/bjnewman/extra-steps-dev/issues/new?title=Term%3A+" class="suggest-cta__link">Suggest a term →</a>
    </div>
  </div>

  <!-- Empty state -->
  <div class="empty-state" id="empty-state" hidden>
    <p class="empty-state__text">
      No terms matching <strong id="empty-query"></strong>
    </p>
    <p class="empty-state__sub">Know what it actually is? <a href="https://github.com/bjnewman/extra-steps-dev">Add it →</a></p>
  </div>
</Base>

<style>
  /* Search bar in header */
  .header-search {
    flex: 1;
    max-width: 28rem;
  }

  .header-search__wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-search__icon {
    position: absolute;
    left: var(--space-3);
    color: var(--color-search-placeholder);
    pointer-events: none;
    flex-shrink: 0;
  }

  .header-search__input {
    width: 100%;
    background: var(--color-search-bg);
    border: 1px solid var(--color-search-border);
    border-radius: var(--border-radius);
    padding: var(--space-2) var(--space-8) var(--space-2) calc(var(--space-3) + 14px + var(--space-2));
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-search-text);
    transition: border-color var(--duration-fast) var(--easing-standard);
  }

  .header-search__input::placeholder {
    color: var(--color-search-placeholder);
  }

  .header-search__input:focus-visible {
    border-color: var(--color-search-border-focus);
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  /* Hide browser's native clear button */
  .header-search__input::-webkit-search-cancel-button { display: none; }

  .header-search__kbd {
    position: absolute;
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-search-placeholder);
    background: oklch(28% 0.02 255);
    border: 1px solid oklch(35% 0.02 255);
    border-radius: 3px;
    padding: 1px 5px;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--easing-standard);
  }

  .header-search__input:focus-visible + .header-search__kbd,
  .header-search__input:not(:placeholder-shown) + .header-search__kbd {
    opacity: 0;
  }

  /* Table column headers */
  .table-header {
    border-block-end: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .table-header__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .table-cols {
    display: grid;
    grid-template-columns: 8.5rem 14rem 1fr;
    gap: var(--space-3);
    flex: 1;
  }

  .table-cols__item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .table-cols__item--span {
    grid-column: 3 / -1;
  }

  .table-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    white-space: nowrap;
    padding-inline-start: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .table-count__sep {
    color: var(--color-border);
  }

  .table-count__link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .table-count__link:hover {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* Terms list */
  .terms-list {
    list-style: none;
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .terms-list__item[hidden] {
    display: none;
  }

  /* Suggest a term CTA */
  .suggest-cta {
    border-block-start: 1px solid var(--color-border);
    background: var(--color-accent-bg);
  }

  .suggest-cta__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .suggest-cta__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .suggest-cta__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .suggest-cta__link:hover {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* Empty state */
  .empty-state {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4);
    text-align: center;
  }

  .empty-state__text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .empty-state__text strong {
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .empty-state__sub {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  /* Category filter select */
  .table-cols__item--filter {
    display: flex;
    align-items: center;
  }

  .table-filter-select {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--border-radius-sm);
    padding: 2px var(--space-2);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--easing-standard),
                color var(--duration-fast) var(--easing-standard);
  }

  .table-filter-select:hover,
  .table-filter-select:focus-visible {
    border-color: var(--color-border);
    color: var(--color-accent);
  }

  .table-filter-select.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Sortable column headers */
  .table-cols__item--sortable {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border: none;
    background: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .table-cols__item--sortable:hover,
  .table-cols__item--sortable:focus-visible {
    color: var(--color-accent);
  }

  .sort-icon {
    opacity: 0.4;
    transition: opacity var(--duration-fast) var(--easing-standard),
                transform var(--duration-fast) var(--easing-standard);
  }

  .table-cols__item--sortable:hover .sort-icon {
    opacity: 0.7;
  }

  .table-cols__item--sortable[aria-sort] .sort-icon {
    opacity: 1;
    color: var(--color-accent);
  }

  .table-cols__item--sortable[aria-sort="descending"] .sort-icon {
    transform: rotate(180deg);
  }

  /* Active filter indicator */
  .table-header__clear {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px var(--space-2);
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .table-header__clear:hover {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .table-cols__item--sortable {
      display: none;
    }
  }
</style>

<script>
  // Elements
  const input = document.getElementById('search-input') as HTMLInputElement;
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement;
  const items = document.querySelectorAll<HTMLElement>('.terms-list__item');
  const termsList = document.getElementById('terms-list') as HTMLElement;
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const emptyQuery = document.getElementById('empty-query');
  const suggestCta = document.getElementById('suggest-cta') as HTMLElement;
  const sortBtns = document.querySelectorAll<HTMLButtonElement>('[data-sort]');

  // State
  let searchQuery = '';
  let categoryFilter = '';
  let sortField = '';
  let sortDir: 'asc' | 'desc' = 'asc';

  function applyFilters() {
    const q = searchQuery.trim().toLowerCase();
    let visible = 0;

    items.forEach((item) => {
      const matchSearch = !q || (item.dataset.term ?? '').includes(q);
      const matchCategory = !categoryFilter || item.dataset.category === categoryFilter;
      item.hidden = !(matchSearch && matchCategory);
      if (!item.hidden) visible++;
    });

    if (resultCount) resultCount.textContent = String(visible);

    const hasFilter = !!q || !!categoryFilter;
    emptyState.hidden = visible > 0 || !hasFilter;
    if (suggestCta) suggestCta.hidden = visible === 0 && hasFilter;

    if (emptyQuery && !emptyState.hidden) {
      const parts: string[] = [];
      if (q) parts.push(`"${searchQuery}"`);
      if (categoryFilter) parts.push(categoryFilter);
      emptyQuery.textContent = parts.join(' in ');
    }

    categorySelect?.classList.toggle('is-active', !!categoryFilter);
  }

  function applySort() {
    const list = [...items].sort((a, b) => {
      if (!sortField) {
        // Default: publishedAt descending
        const da = a.dataset.published ?? '';
        const db = b.dataset.published ?? '';
        return db.localeCompare(da);
      }
      const va = a.dataset[sortField] ?? '';
      const vb = b.dataset[sortField] ?? '';
      const cmp = va.localeCompare(vb);
      return sortDir === 'desc' ? -cmp : cmp;
    });
    list.forEach((item) => termsList.appendChild(item));
  }

  function updateSortIndicators() {
    sortBtns.forEach((btn) => {
      if (btn.dataset.sort === sortField) {
        btn.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
      } else {
        btn.removeAttribute('aria-sort');
      }
    });
  }

  function updateURL() {
    const url = new URL(window.location.href);
    if (categoryFilter) url.searchParams.set('category', categoryFilter);
    else url.searchParams.delete('category');
    if (sortField) {
      url.searchParams.set('sort', sortField);
      url.searchParams.set('dir', sortDir);
    } else {
      url.searchParams.delete('sort');
      url.searchParams.delete('dir');
    }
    history.replaceState(null, '', url.toString());
  }

  // Search input
  input?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  // Category select
  categorySelect?.addEventListener('change', () => {
    categoryFilter = categorySelect.value;
    applyFilters();
    updateURL();
  });

  // Category badge click (event delegation)
  termsList?.addEventListener('click', (e) => {
    const badge = (e.target as HTMLElement).closest('[data-filter-category]') as HTMLElement | null;
    if (!badge) return;
    e.stopPropagation();
    e.preventDefault();

    const cat = badge.dataset.filterCategory ?? '';
    categoryFilter = categoryFilter === cat ? '' : cat;
    if (categorySelect) categorySelect.value = categoryFilter;
    applyFilters();
    updateURL();
  });

  // Sort column headers
  sortBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const field = btn.dataset.sort!;
      if (sortField === field) {
        if (sortDir === 'asc') {
          sortDir = 'desc';
        } else {
          sortField = '';
          sortDir = 'asc';
        }
      } else {
        sortField = field;
        sortDir = 'asc';
      }
      applySort();
      applyFilters();
      updateSortIndicators();
      updateURL();
    });
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      input.blur();
      searchQuery = '';
      applyFilters();
    }
  });

  // Init from URL params
  (function initFromURL() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    if (cat) {
      categoryFilter = cat;
      if (categorySelect) categorySelect.value = cat;
    }
    const sort = params.get('sort');
    const dir = params.get('dir');
    if (sort) {
      sortField = sort;
      sortDir = dir === 'desc' ? 'desc' : 'asc';
      applySort();
      updateSortIndicators();
    }
    if (cat) applyFilters();
  })();
</script>
