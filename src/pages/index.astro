---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TermRow from '../components/TermRow.astro';

const allTerms = await getCollection('terms', ({ data }) => !data.draft);
const sortedTerms = allTerms.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---

<Base title="extra-steps.dev" showSearch={true}>
  <!-- Search bar in header slot -->
  <div slot="search" class="header-search">
    <label for="search-input" class="visually-hidden">Search terms</label>
    <div class="header-search__wrapper">
      <svg class="header-search__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="6.5" cy="6.5" r="5" stroke="currentColor" stroke-width="1.5"/>
        <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search terms, primitives…"
        autocomplete="off"
        spellcheck="false"
        class="header-search__input"
      />
      <kbd class="header-search__kbd" aria-hidden="true">/</kbd>
    </div>
  </div>

  <!-- Table header -->
  <div class="table-header">
    <div class="table-header__inner">
      <div class="table-cols">
        <span class="table-cols__item">category</span>
        <span class="table-cols__item">term</span>
        <span class="table-cols__item table-cols__item--span">primitives</span>
      </div>
      <div class="table-count">
        <span id="result-count">{sortedTerms.length}</span> terms
      </div>
    </div>
  </div>

  <!-- Terms list -->
  <div class="terms-list" id="terms-list" role="list" aria-label="All terms">
    {sortedTerms.map((term) => (
      <div role="listitem" class="terms-list__item" data-term={`${term.data.title} ${term.data.aka ?? ''} ${term.data.primitives.join(' ')} ${term.data.tagline} ${term.data.category}`.toLowerCase()}>
        <TermRow
          id={term.id}
          title={term.data.title}
          aka={term.data.aka}
          tagline={term.data.tagline}
          primitives={term.data.primitives}
          category={term.data.category}
          snippet={term.data.snippet}
        />
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <div class="empty-state" id="empty-state" hidden>
    <p class="empty-state__text">
      No terms matching <strong id="empty-query"></strong>
    </p>
    <p class="empty-state__sub">Know what it actually is? <a href="https://github.com/bjnewman/extra-steps-dev">Add it →</a></p>
  </div>
</Base>

<style>
  /* Search bar in header */
  .header-search {
    flex: 1;
    max-width: 28rem;
  }

  .header-search__wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header-search__icon {
    position: absolute;
    left: var(--space-3);
    color: var(--color-search-placeholder);
    pointer-events: none;
    flex-shrink: 0;
  }

  .header-search__input {
    width: 100%;
    background: var(--color-search-bg);
    border: 1px solid var(--color-search-border);
    border-radius: var(--border-radius);
    padding: var(--space-2) var(--space-8) var(--space-2) calc(var(--space-3) + 14px + var(--space-2));
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-search-text);
    outline: none;
    transition: border-color var(--duration-fast) var(--easing-standard),
                box-shadow var(--duration-fast) var(--easing-standard);
  }

  .header-search__input::placeholder {
    color: var(--color-search-placeholder);
  }

  .header-search__input:focus {
    border-color: var(--color-search-border-focus);
    box-shadow: 0 0 0 3px oklch(58% 0.22 280 / 0.15);
  }

  /* Hide browser's native clear button */
  .header-search__input::-webkit-search-cancel-button { display: none; }

  .header-search__kbd {
    position: absolute;
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-search-placeholder);
    background: oklch(28% 0.02 255);
    border: 1px solid oklch(35% 0.02 255);
    border-radius: 3px;
    padding: 1px 5px;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--easing-standard);
  }

  .header-search__input:focus + .header-search__kbd,
  .header-search__input:not(:placeholder-shown) + .header-search__kbd {
    opacity: 0;
  }

  /* Table column headers */
  .table-header {
    border-block-end: 1px solid var(--color-border);
    background: var(--color-surface-raised);
  }

  .table-header__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .table-cols {
    display: grid;
    grid-template-columns: 6rem 14rem 1fr;
    gap: var(--space-3);
    flex: 1;
  }

  .table-cols__item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .table-cols__item--span {
    grid-column: 3 / -1;
  }

  .table-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    white-space: nowrap;
    padding-inline-start: var(--space-4);
  }

  /* Terms list */
  .terms-list {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .terms-list__item[hidden] {
    display: none;
  }

  /* Empty state */
  .empty-state {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4);
    text-align: center;
  }

  .empty-state__text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .empty-state__text strong {
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .empty-state__sub {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
</style>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const items = document.querySelectorAll<HTMLElement>('.terms-list__item');
  const resultCount = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const emptyQuery = document.getElementById('empty-query');
  const total = items.length;

  // Focus search with '/' key
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== input) {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape' && document.activeElement === input) {
      input.value = '';
      input.blur();
      filter('');
    }
  });

  function filter(query: string) {
    const q = query.trim().toLowerCase();
    let visible = 0;

    items.forEach((item) => {
      const text = item.dataset.term ?? '';
      const match = !q || text.includes(q);
      item.hidden = !match;
      if (match) visible++;
    });

    if (resultCount) resultCount.textContent = String(visible);
    emptyState.hidden = visible > 0 || !q;
    if (emptyQuery) emptyQuery.textContent = `"${query}"`;
  }

  input?.addEventListener('input', (e) => {
    filter((e.target as HTMLInputElement).value);
  });
</script>
