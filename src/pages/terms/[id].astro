---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const terms = await getCollection('terms', ({ data }) => !data.draft);
  return terms.map((term) => ({
    params: { id: term.id },
    props: { term },
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);

/** Lookup table: primitive name → { description, url } */
const PRIMITIVES: Record<string, { description: string; url: string }> = {
  'JSON-RPC': {
    description: 'A remote procedure call protocol that uses JSON to encode requests and responses.',
    url: 'https://en.wikipedia.org/wiki/JSON-RPC',
  },
  'stdio': {
    description: 'Standard input/output streams — the default way Unix processes send and receive data.',
    url: 'https://en.wikipedia.org/wiki/Standard_streams',
  },
  'while loop': {
    description: 'A control flow statement that repeats a block of code as long as a condition holds.',
    url: 'https://en.wikipedia.org/wiki/While_loop',
  },
  'LLM call': {
    description: 'A single request/response to a language model API — the atomic unit of agent work.',
    url: 'https://en.wikipedia.org/wiki/Large_language_model',
  },
  'tool dispatch': {
    description: 'Selecting and invoking a function from a registry based on a name and arguments.',
    url: 'https://en.wikipedia.org/wiki/Dynamic_dispatch',
  },
  'JSON serialization': {
    description: 'Converting data structures to and from the JSON text format for storage or transmission.',
    url: 'https://en.wikipedia.org/wiki/JSON',
  },
  'function dispatch': {
    description: 'Calling a function by name at runtime — the same mechanism as any callback system.',
    url: 'https://en.wikipedia.org/wiki/Function_pointer',
  },
  'markdown': {
    description: 'A lightweight markup language that converts plain text to HTML.',
    url: 'https://en.wikipedia.org/wiki/Markdown',
  },
  'YAML frontmatter': {
    description: 'A YAML metadata block at the top of a text file, delimited by `---`.',
    url: 'https://en.wikipedia.org/wiki/YAML',
  },
  'prompt templates': {
    description: 'Strings with placeholders that get filled in before being sent to a model.',
    url: 'https://en.wikipedia.org/wiki/Template_processor',
  },
  'key/value store': {
    description: 'The simplest database model: store and retrieve arbitrary values by a unique key.',
    url: 'https://en.wikipedia.org/wiki/Key%E2%80%93value_database',
  },
  'file append': {
    description: 'Writing new data to the end of an existing file without overwriting prior contents.',
    url: 'https://en.wikipedia.org/wiki/Append_(file)',
  },
  'system prompt injection': {
    description: 'Prepending or appending text to the system prompt before each model call.',
    url: 'https://en.wikipedia.org/wiki/Prompt_engineering',
  },
  // Dropbox
  'rsync': {
    description: 'A utility that efficiently transfers and synchronizes files by computing and sending only the differences.',
    url: 'https://en.wikipedia.org/wiki/Rsync',
  },
  'inotify': {
    description: 'A Linux kernel subsystem that monitors filesystem events — file creation, modification, and deletion — in real time.',
    url: 'https://en.wikipedia.org/wiki/Inotify',
  },
  'cloud storage': {
    description: 'Remote file storage accessed over a network, abstracting away the physical location of data.',
    url: 'https://en.wikipedia.org/wiki/Cloud_storage',
  },
  // Docker
  'cgroups': {
    description: 'Linux kernel feature that limits, accounts for, and isolates the resource usage of process groups.',
    url: 'https://en.wikipedia.org/wiki/Cgroups',
  },
  'namespaces': {
    description: 'A Linux kernel feature that partitions system resources so each process group has its own isolated view.',
    url: 'https://en.wikipedia.org/wiki/Linux_namespaces',
  },
  'union filesystem': {
    description: 'A filesystem that layers multiple directories on top of each other, presenting a merged view.',
    url: 'https://en.wikipedia.org/wiki/UnionFS',
  },
  // Kubernetes
  'control loop': {
    description: 'A feedback loop that continuously compares desired state to actual state and takes corrective action.',
    url: 'https://en.wikipedia.org/wiki/Control_loop',
  },
  'declarative config': {
    description: 'Specifying what the system should look like rather than the steps to get there — the system reconciles the difference.',
    url: 'https://en.wikipedia.org/wiki/Declarative_programming',
  },
  'container orchestration': {
    description: 'Automated management of containerized applications across multiple hosts — scheduling, scaling, and networking.',
    url: 'https://en.wikipedia.org/wiki/Container_orchestration',
  },
  // Serverless
  'process isolation': {
    description: 'Restricting a process\'s access to system resources and other processes, preventing interference.',
    url: 'https://en.wikipedia.org/wiki/Process_isolation',
  },
  'event-driven invocation': {
    description: 'Executing code in response to events — an HTTP request, a message, or a timer — rather than running continuously.',
    url: 'https://en.wikipedia.org/wiki/Event-driven_architecture',
  },
  'managed infrastructure': {
    description: 'Infrastructure operated by a third party — the provider handles provisioning, patching, and scaling.',
    url: 'https://en.wikipedia.org/wiki/Managed_services',
  },
  // RAG
  'search index': {
    description: 'A data structure optimized for fast retrieval of documents matching a query — inverted index, B-tree, or vector index.',
    url: 'https://en.wikipedia.org/wiki/Search_engine_indexing',
  },
  'string concatenation': {
    description: 'Joining two or more strings end-to-end to produce a new string.',
    url: 'https://en.wikipedia.org/wiki/Concatenation',
  },
  // Embeddings
  'hash function': {
    description: 'A function that maps input data of arbitrary size to fixed-size output values.',
    url: 'https://en.wikipedia.org/wiki/Hash_function',
  },
  'nearest-neighbor search': {
    description: 'Finding the closest point(s) to a query point in a metric space.',
    url: 'https://en.wikipedia.org/wiki/Nearest_neighbor_search',
  },
  // Prompt Engineering
  'natural language': {
    description: 'Human language as used in everyday communication — as opposed to formal or programming languages.',
    url: 'https://en.wikipedia.org/wiki/Natural_language',
  },
  // Guardrails
  'input validation': {
    description: 'Checking that input data conforms to expected rules before processing it.',
    url: 'https://en.wikipedia.org/wiki/Data_validation',
  },
  'output sanitization': {
    description: 'Cleaning or transforming output data to remove unsafe or unwanted content before returning it.',
    url: 'https://en.wikipedia.org/wiki/HTML_sanitization',
  },
  'regex / classifier filters': {
    description: 'Pattern matching (regex) or machine-learned classifiers used to detect and filter specific content.',
    url: 'https://en.wikipedia.org/wiki/Regular_expression',
  },
  // Webhooks
  'HTTP POST': {
    description: 'An HTTP request method that submits data to a server for processing.',
    url: 'https://en.wikipedia.org/wiki/POST_(HTTP)',
  },
  'callback function': {
    description: 'A function passed as an argument to be invoked later when an event occurs.',
    url: 'https://en.wikipedia.org/wiki/Callback_(computer_programming)',
  },
};

const akaList = term.data.aka
  ? (Array.isArray(term.data.aka) ? term.data.aka : [term.data.aka])
  : [];
---

<Base title={term.data.title} description={term.data.tagline}>
  <div class="detail-wrap">

    <!-- Breadcrumb back -->
    <nav class="detail-nav" aria-label="Breadcrumb">
      <a href="/" class="detail-nav__back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All terms
      </a>
    </nav>

    <!-- Hero: the equation -->
    <header class="detail-hero">
      <div class="detail-hero__eq">
        <span class="detail-hero__term">{term.data.title}</span>
        <span class="detail-hero__eq-sign" aria-hidden="true">=</span>
        <span class="detail-hero__primitives">
          {term.data.primitives.map((p, i) => (
            <>
              <span class="detail-hero__primitive">{p}</span>
              {i < term.data.primitives.length - 1 && (
                <span class="detail-hero__plus" aria-hidden="true">+</span>
              )}
            </>
          ))}
        </span>
      </div>

      {akaList.length > 0 && (
        <p class="detail-hero__aka">also: {akaList.join(' · ')}</p>
      )}

      <div class="detail-hero__meta">
        <span class="detail-hero__badge">{term.data.category}</span>
        <span class="detail-hero__audience">{term.data.audience}</span>
      </div>

      <!-- TL;DR strip -->
      <blockquote class="detail-tldr">
        <span class="detail-tldr__label" aria-hidden="true">TL;DR</span>
        <p class="detail-tldr__text">{term.data.tagline}</p>
        <button
          class="copy-btn copy-btn--detail"
          type="button"
          data-copy={term.data.tagline}
          aria-label="Copy tagline"
        >
          <svg class="copy-btn__icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="copy-btn__feedback" aria-live="polite"></span>
        </button>
      </blockquote>
    </header>

    <!-- Under the hood: primitives reference strip -->
    <div class="detail-primitives">
      <h2 class="detail-primitives__heading">Under the hood</h2>
      <ul class="detail-primitives__list">
        {term.data.primitives.map((p) => {
          const ref = PRIMITIVES[p];
          return (
            <li class="detail-primitives__item">
              <span class="detail-primitives__name">{p}</span>
              {ref ? (
                <>
                  <span class="detail-primitives__sep" aria-hidden="true">—</span>
                  <span class="detail-primitives__desc">{ref.description}</span>
                  <a
                    href={ref.url}
                    class="detail-primitives__link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >Wikipedia ↗</a>
                </>
              ) : null}
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Rendered markdown -->
    <div class="detail-content prose">
      <Content />
    </div>

    <!-- Suggest a term -->
    <aside class="suggest-cta-detail">
      <p class="suggest-cta-detail__text">Think a term is wrong, or know one we're missing?</p>
      <a href="https://github.com/bjnewman/extra-steps-dev/issues/new?title=Term%3A+" class="suggest-cta-detail__link">Suggest a term →</a>
    </aside>

  </div>
</Base>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────── */
  .detail-wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-8) var(--space-16);
  }

  /* ── Back nav ─────────────────────────────────────────────────── */
  .detail-nav {
    margin-block-end: var(--space-6);
  }

  .detail-nav__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .detail-nav__back:hover {
    color: var(--color-accent);
  }

  /* ── Hero equation ────────────────────────────────────────────── */
  .detail-hero {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
  }

  .detail-hero__eq {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-block-end: var(--space-3);
  }

  .detail-hero__term {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--weight-bold);
    color: var(--color-marketing);
    line-height: 1;
  }

  .detail-hero__eq-sign {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-arrow);
    font-weight: var(--weight-normal);
    line-height: 1;
  }

  .detail-hero__primitives {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .detail-hero__primitive {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3.5vw, 2rem);
    font-weight: var(--weight-bold);
    color: var(--color-primitive);
    line-height: 1;
  }

  .detail-hero__plus {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: var(--color-arrow);
    line-height: 1;
  }

  .detail-hero__aka {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-3);
  }

  .detail-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
  }

  .detail-hero__badge,
  .detail-hero__audience {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 2px var(--space-2);
    border-radius: var(--border-radius-sm);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .detail-hero__badge {
    color: var(--color-badge-text);
    background: var(--color-badge-bg);
  }

  .detail-hero__audience {
    color: var(--color-text-subtle);
    background: var(--color-surface-raised);
  }

  /* ── TL;DR strip ──────────────────────────────────────────────── */
  .detail-tldr {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    background: var(--color-accent-bg);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    padding: var(--space-3) var(--space-4);
  }

  .detail-tldr__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .detail-tldr__text {
    font-size: var(--text-base);
    color: var(--color-text);
    font-style: italic;
    line-height: var(--leading-normal);
    flex: 1;
  }

  /* ── Suggest CTA ────────────────────────────────────────────────── */
  .suggest-cta-detail {
    margin-block-start: var(--space-12);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-accent-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .suggest-cta-detail__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .suggest-cta-detail__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .suggest-cta-detail__link:hover {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* ── Copy button ───────────────────────────────────────────────── */
  .copy-btn--detail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-subtle);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--border-radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .copy-btn--detail:hover {
    color: var(--color-accent);
  }

  .copy-btn--detail:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .copy-btn--detail[data-copied] {
    color: var(--color-primitive);
  }

  .copy-btn--detail .copy-btn__feedback:empty { display: none; }

  /* ── Primitives strip ─────────────────────────────────────────── */
  .detail-primitives {
    margin-block-end: var(--space-8);
  }

  .detail-primitives__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
  }

  .detail-primitives__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .detail-primitives__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .detail-primitives__item:last-child {
    border-block-end: none;
  }

  .detail-primitives__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-primitive);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .detail-primitives__sep {
    color: var(--color-arrow);
    flex-shrink: 0;
  }

  .detail-primitives__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    flex: 1;
    min-width: 12ch;
  }

  .detail-primitives__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .detail-primitives__link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* ── Prose content ────────────────────────────────────────────── */
  .detail-content {
    line-height: var(--leading-relaxed);
  }

  /* Section headings */
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-start: var(--space-12);
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-2);
  }

  .prose :global(p) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }

  /* "What they say" blockquote — the hype */
  .prose :global(blockquote) {
    position: relative;
    border-inline-start: 3px solid var(--color-marketing);
    background: var(--color-marketing-bg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  /* Inline code */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface-raised);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: var(--color-primitive);
  }

  /* Code blocks */
  .prose :global(pre) {
    position: relative;
    background: var(--color-header-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-4);
    overflow-x: auto;
    margin-block: var(--space-4);
    /* Subtle scanline to match header */
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      oklch(100% 0 0 / 0.012) 2px,
      oklch(100% 0 0 / 0.012) 4px
    );
  }

  .prose :global(pre code) {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-on-dark);
    background: none;
    padding: 0;
    border-radius: 0;
  }

  /* Lists */
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-6);
    margin-block-end: var(--space-4);
  }

  .prose :global(li) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
    line-height: var(--leading-normal);
  }

  .prose :global(li strong) {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /* Strong in prose */
  .prose :global(p strong) {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /* ── Inline footnote references ─────────────────────────────── */
  /* The [1] superscript links in body text — remark-gfm uses data-footnote-ref */
  .prose :global([data-footnote-ref]) {
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-bold);
    padding-inline: 1px;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .prose :global([data-footnote-ref]:hover) {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  /* ── Footnotes section at page bottom ───────────────────────── */
  /* remark-gfm renders <section data-footnotes class="footnotes"> */
  .prose :global([data-footnotes]) {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  /* Hide the default <hr> remark-gfm inserts before footnotes */
  .prose :global([data-footnotes] > hr) {
    display: none;
  }

  /* The sr-only h2 remark-gfm inserts — keep it accessible but invisible */
  .prose :global([data-footnotes] > h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Visual "references" label above the footnote box */
  .prose :global([data-footnotes])::before {
    content: "References";
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-3);
  }

  /* Footnote list */
  .prose :global([data-footnotes] ol) {
    list-style: none;
    padding-inline-start: 0;
    margin: 0;
  }

  .prose :global([data-footnotes] li) {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--color-border);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .prose :global([data-footnotes] li:last-child) {
    border-block-end: none;
  }

  /* The footnote number */
  .prose :global([data-footnotes] li::before) {
    content: "[" counter(list-item) "]";
    counter-increment: list-item;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    flex-shrink: 0;
    padding-block-start: 2px;
  }

  /* Links inside footnotes */
  .prose :global([data-footnotes] li a:not([data-footnote-backref])) {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  .prose :global([data-footnotes] li a:not([data-footnote-backref]):hover) {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* Hide the ↩ backref links — we don't need them */
  .prose :global([data-footnote-backref]) {
    display: none;
  }

  /* Wrap the footnote list in a bordered container */
  .prose :global([data-footnotes] ol) {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn--detail');
    if (!btn) return;

    const text = btn.dataset.copy;
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const feedback = btn.querySelector('.copy-btn__feedback');
      btn.dataset.copied = '';
      if (feedback) feedback.textContent = 'Copied!';

      setTimeout(() => {
        delete btn.dataset.copied;
        if (feedback) feedback.textContent = '';
      }, 1500);
    });
  });
</script>
