---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const terms = await getCollection('terms', ({ data }) => !data.draft);
  return terms.map((term) => ({
    params: { id: term.id },
    props: { term },
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);
---

<Base title={term.data.title} description={term.data.tagline}>
  <div class="detail-wrap">

    <!-- Breadcrumb back -->
    <nav class="detail-nav" aria-label="Breadcrumb">
      <a href="/" class="detail-nav__back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All terms
      </a>
    </nav>

    <!-- Hero: the equation -->
    <header class="detail-hero">
      <div class="detail-hero__eq">
        <span class="detail-hero__term">{term.data.title}</span>
        <span class="detail-hero__eq-sign" aria-hidden="true">=</span>
        <span class="detail-hero__primitives">
          {term.data.primitives.map((p, i) => (
            <>
              <span class="detail-hero__primitive">{p}</span>
              {i < term.data.primitives.length - 1 && (
                <span class="detail-hero__plus" aria-hidden="true">+</span>
              )}
            </>
          ))}
        </span>
      </div>

      {term.data.aka && (
        <p class="detail-hero__aka">{term.data.aka}</p>
      )}

      <div class="detail-hero__meta">
        <span class="detail-hero__badge">{term.data.category}</span>
        <span class="detail-hero__audience">{term.data.audience}</span>
      </div>

      <!-- TL;DR strip -->
      <blockquote class="detail-tldr">
        <span class="detail-tldr__label" aria-hidden="true">TL;DR</span>
        <p class="detail-tldr__text">{term.data.tagline}</p>
      </blockquote>
    </header>

    <!-- Rendered markdown -->
    <div class="detail-content prose">
      <Content />
    </div>

  </div>
</Base>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────── */
  .detail-wrap {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-8) var(--space-16);
  }

  /* ── Back nav ─────────────────────────────────────────────────── */
  .detail-nav {
    margin-block-end: var(--space-6);
  }

  .detail-nav__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .detail-nav__back:hover {
    color: var(--color-accent);
  }

  /* ── Hero equation ────────────────────────────────────────────── */
  .detail-hero {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-8);
    border-block-end: 1px solid var(--color-border);
  }

  .detail-hero__eq {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-block-end: var(--space-3);
  }

  .detail-hero__term {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: var(--weight-bold);
    color: var(--color-marketing);
    line-height: 1;
  }

  .detail-hero__eq-sign {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-arrow);
    font-weight: var(--weight-normal);
    line-height: 1;
  }

  .detail-hero__primitives {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .detail-hero__primitive {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3.5vw, 2rem);
    font-weight: var(--weight-bold);
    color: var(--color-primitive);
    line-height: 1;
  }

  .detail-hero__plus {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    color: var(--color-arrow);
    line-height: 1;
  }

  .detail-hero__aka {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-3);
  }

  .detail-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
  }

  .detail-hero__badge,
  .detail-hero__audience {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 2px var(--space-2);
    border-radius: var(--border-radius-sm);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .detail-hero__badge {
    color: var(--color-badge-text);
    background: var(--color-badge-bg);
  }

  .detail-hero__audience {
    color: var(--color-text-subtle);
    background: var(--color-surface-raised);
  }

  /* ── TL;DR strip ──────────────────────────────────────────────── */
  .detail-tldr {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    background: var(--color-accent-bg);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    padding: var(--space-3) var(--space-4);
  }

  .detail-tldr__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .detail-tldr__text {
    font-size: var(--text-base);
    color: var(--color-text);
    font-style: italic;
    line-height: var(--leading-normal);
  }

  /* ── Prose content ────────────────────────────────────────────── */
  .detail-content {
    line-height: var(--leading-relaxed);
  }

  /* Section headings */
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-start: var(--space-12);
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--color-border);
  }

  .prose :global(h3) {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-block-start: var(--space-6);
    margin-block-end: var(--space-2);
  }

  .prose :global(p) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }

  /* "What they say" blockquote — the hype */
  .prose :global(blockquote) {
    position: relative;
    border-inline-start: 3px solid var(--color-marketing);
    background: var(--color-marketing-bg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  /* Inline code */
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface-raised);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: var(--color-primitive);
  }

  /* Code blocks */
  .prose :global(pre) {
    position: relative;
    background: var(--color-header-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--space-4);
    overflow-x: auto;
    margin-block: var(--space-4);
    /* Subtle scanline to match header */
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      oklch(100% 0 0 / 0.012) 2px,
      oklch(100% 0 0 / 0.012) 4px
    );
  }

  .prose :global(pre code) {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-on-dark);
    background: none;
    padding: 0;
    border-radius: 0;
  }

  /* Lists */
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-6);
    margin-block-end: var(--space-4);
  }

  .prose :global(li) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
    line-height: var(--leading-normal);
  }

  .prose :global(li strong) {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /* Strong in prose */
  .prose :global(p strong) {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  /* ── Inline footnote references ─────────────────────────────── */
  /* The [1] superscript links in body text — remark-gfm uses data-footnote-ref */
  .prose :global([data-footnote-ref]) {
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: super;
    line-height: 0;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-bold);
    padding-inline: 1px;
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .prose :global([data-footnote-ref]:hover) {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  /* ── Footnotes section at page bottom ───────────────────────── */
  /* remark-gfm renders <section data-footnotes class="footnotes"> */
  .prose :global([data-footnotes]) {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  /* Hide the default <hr> remark-gfm inserts before footnotes */
  .prose :global([data-footnotes] > hr) {
    display: none;
  }

  /* The sr-only h2 remark-gfm inserts — keep it accessible but invisible */
  .prose :global([data-footnotes] > h2) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Visual "references" label above the footnote box */
  .prose :global([data-footnotes])::before {
    content: "References";
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-subtle);
    margin-block-end: var(--space-3);
  }

  /* Footnote list */
  .prose :global([data-footnotes] ol) {
    list-style: none;
    padding-inline-start: 0;
    margin: 0;
  }

  .prose :global([data-footnotes] li) {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--color-border);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .prose :global([data-footnotes] li:last-child) {
    border-block-end: none;
  }

  /* The footnote number */
  .prose :global([data-footnotes] li::before) {
    content: "[" counter(list-item) "]";
    counter-increment: list-item;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    flex-shrink: 0;
    padding-block-start: 2px;
  }

  /* Links inside footnotes */
  .prose :global([data-footnotes] li a:not([data-footnote-backref])) {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  .prose :global([data-footnotes] li a:not([data-footnote-backref]):hover) {
    text-decoration: underline;
    color: var(--color-accent-hover);
  }

  /* Hide the ↩ backref links — we don't need them */
  .prose :global([data-footnote-backref]) {
    display: none;
  }

  /* Wrap the footnote list in a bordered container */
  .prose :global([data-footnotes] ol) {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    overflow: hidden;
  }
</style>
