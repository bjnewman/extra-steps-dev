---
/**
 * TermCard — displays a single term mapping on the index page.
 *
 * Visual structure:
 *   "MCP" → JSON-RPC + stdio
 *   Model Context Protocol
 *   [protocols]
 */
interface Props {
  id: string;
  title: string;
  aka?: string;
  tagline: string;
  primitives: string[];
  category: string;
}

const { id, title, aka, tagline, primitives, category } = Astro.props;
---

<article class="term-card">
  <a href={`/terms/${id}/`} class="term-card__link">
    <div class="term-card__mapping">
      <span class="term-card__marketing">{title}</span>
      <span class="term-card__arrow" aria-hidden="true">&rarr;</span>
      <span class="term-card__primitives">
        {primitives.join(' + ')}
      </span>
    </div>
    {aka && <p class="term-card__aka">{aka}</p>}
    <p class="term-card__tagline">{tagline}</p>
    <span class="term-card__category">{category}</span>
  </a>
</article>

<style>
  .term-card {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-surface);
    transition: border-color var(--duration-fast) var(--easing-standard),
                box-shadow var(--duration-fast) var(--easing-standard);
  }

  .term-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 2px 8px oklch(0% 0 0 / 0.06);
  }

  .term-card__link {
    display: block;
    padding: var(--space-4) var(--space-6);
    text-decoration: none;
    color: inherit;
  }

  .term-card__mapping {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .term-card__marketing {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-marketing);
  }

  .term-card__arrow {
    color: var(--color-arrow);
    font-size: var(--text-lg);
  }

  .term-card__primitives {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primitive);
  }

  .term-card__aka {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-block-start: var(--space-1);
  }

  .term-card__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-block-start: var(--space-2);
    font-style: italic;
  }

  .term-card__category {
    display: inline-block;
    margin-block-start: var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: var(--color-accent-bg);
    padding: var(--space-1) var(--space-2);
    border-radius: 3px;
    text-transform: lowercase;
  }
</style>
